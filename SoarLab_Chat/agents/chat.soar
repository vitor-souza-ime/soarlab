sp {chat*episodic-exact*query
  (state <s> ^io.input-link <in> ^epmem.command <cmd>)
  (<in> ^request <req>)
  (<req> ^intent episodic-exact ^topic <topic> ^content <content> ^seq <seq>)
-->
  (<cmd> ^query <cue>)
  (<cue> ^io <io>)
  (<io> ^input-link <past-in>)
  (<past-in> ^request <past>)
  (<past> ^intent experience ^topic <topic> ^content <content>)
}

sp {chat*episodic-exact*found
  (state <s> ^io.input-link <in> ^io.output-link <out>
             ^epmem.command <cmd> ^epmem.result <result>)
  (<in> ^request <req>)
  (<req> ^intent episodic-exact ^topic <topic> ^content <content> ^seq <seq>)
  (<cmd> ^query <cue>)
  (<result> ^success <cue> ^retrieved <episode>)
  (<episode> ^io <io>)
  (<io> ^input-link <past-in>)
  (<past-in> ^request <past>)
  (<past> ^intent experience ^topic <topic> ^content <content>)
-->
  (<out> ^reply <reply>)
  (<reply> ^seq <seq> ^kind episodic ^status found ^topic <topic>
           ^text <content> ^rule chat*episodic-exact*found)
}

sp {chat*episodic-exact*unknown
  (state <s> ^io.input-link <in> ^io.output-link <out>
             ^epmem.command <cmd> ^epmem.result <result>)
  (<in> ^request <req>)
  (<req> ^intent episodic-exact ^topic <topic> ^content <content> ^seq <seq>)
  (<cmd> ^query <cue>)
  (<result> ^failure <cue>)
-->
  (<out> ^reply <reply>)
  (<reply> ^seq <seq> ^kind episodic ^status unknown ^topic <topic>
           ^text |The requested experience was not retrieved by native EpMem.|
           ^rule chat*episodic-exact*unknown)
}
