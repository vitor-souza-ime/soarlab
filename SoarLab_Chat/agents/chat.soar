# SoarLab Chat 3.0 — Soar 9.6.5 native rules
# All factual output comes from Soar productions and native memory retrieval.
# Procedural scenario-response rules are individually compiled productions.

# SoarLab Chat 2.0 / Soar 9.6.5

sp {chat*semantic*query
  (state <s> ^io.input-link <in> ^smem.command <cmd>)
  (<in> ^request <req>)
  (<req> ^intent semantic ^topic <topic> ^seq <seq>)
-->
  (<cmd> ^query <cue>)
  (<cue> ^topic <topic>)
}

sp {chat*semantic*found
  (state <s> ^io.input-link <in> ^io.output-link <out>
             ^smem.command <cmd> ^smem.result <result>)
  (<in> ^request <req>)
  (<req> ^intent semantic ^topic <topic> ^seq <seq>)
  (<cmd> ^query <cue>)
  (<result> ^success <cue> ^retrieved <memory>)
  (<memory> ^topic <topic> ^description <description>)
-->
  (<out> ^reply <reply>)
  (<reply> ^seq <seq> ^kind semantic ^status found
           ^topic <topic> ^text <description>
           ^rule chat*semantic*found)
}

sp {chat*semantic*unknown
  (state <s> ^io.input-link <in> ^io.output-link <out>
             ^smem.command <cmd> ^smem.result <result>)
  (<in> ^request <req>)
  (<req> ^intent semantic ^topic <topic> ^seq <seq>)
  (<cmd> ^query <cue>)
  (<result> ^failure <cue>)
-->
  (<out> ^reply <reply>)
  (<reply> ^seq <seq> ^kind semantic ^status unknown
           ^topic <topic> ^text |I do not know that concept yet. You can teach it to me.|
           ^rule chat*semantic*unknown)
}

sp {chat*teach*store
  (state <s> ^io.input-link <in> ^smem.command <cmd>)
  (<in> ^request <req>)
  (<req> ^intent teach ^seq <seq> ^topic <topic> ^content <content>)
-->
  (<s> ^learning-record <fact>)
  (<fact> ^topic <topic> ^description <content> ^category robotics)
  (<cmd> ^store-new <fact>)
}

sp {chat*teach*confirmation
  (state <s> ^io.input-link <in> ^io.output-link <out>
             ^smem.result <result> ^learning-record <fact>)
  (<in> ^request <req>)
  (<req> ^intent teach ^seq <seq> ^topic <topic>)
  (<fact> ^topic <topic>)
  (<result> ^success <fact>)
-->
  (<out> ^reply <reply>)
  (<reply> ^seq <seq> ^kind semantic ^status stored ^topic <topic>
           ^text |Storage requested from native SMem; verifying retrieval...|
           ^rule chat*teach*confirmation)
}

sp {chat*experience*registered
  (state <s> ^io.input-link <in> ^io.output-link <out>)
  (<in> ^request <req>)
  (<req> ^intent experience ^seq <seq> ^topic <topic> ^content <content>)
-->
  (<out> ^reply <reply>)
  (<reply> ^seq <seq> ^kind episodic ^status presented ^topic <topic>
           ^text |Event presented to Soar working memory.|
           ^rule chat*experience*registered)
}

sp {chat*episodic*query
  (state <s> ^io.input-link <in> ^epmem.command <cmd>)
  (<in> ^request <req>)
  (<req> ^intent episodic ^topic <topic> ^seq <seq>)
-->
  (<cmd> ^query <cue>)
  (<cue> ^io <io>)
  (<io> ^input-link <past-in>)
  (<past-in> ^request <past>)
  (<past> ^intent experience ^topic <topic>)
}

sp {chat*episodic*found
  (state <s> ^io.input-link <in> ^io.output-link <out>
             ^epmem.command <cmd> ^epmem.result <result>)
  (<in> ^request <req>)
  (<req> ^intent episodic ^topic <topic> ^seq <seq>)
  (<cmd> ^query <cue>)
  (<result> ^success <cue> ^retrieved <episode>)
  (<episode> ^io <io>)
  (<io> ^input-link <past-in>)
  (<past-in> ^request <past>)
  (<past> ^intent experience ^topic <topic> ^content <text>)
-->
  (<out> ^reply <reply>)
  (<reply> ^seq <seq> ^kind episodic ^status found ^topic <topic>
           ^text <text> ^rule chat*episodic*found)
}

sp {chat*episodic*unknown
  (state <s> ^io.input-link <in> ^io.output-link <out>
             ^epmem.command <cmd> ^epmem.result <result>)
  (<in> ^request <req>)
  (<req> ^intent episodic ^topic <topic> ^seq <seq>)
  (<cmd> ^query <cue>)
  (<result> ^failure <cue>)
-->
  (<out> ^reply <reply>)
  (<reply> ^seq <seq> ^kind episodic ^status unknown ^topic <topic>
           ^text |No episode can be retrieved for this cue yet.|
           ^rule chat*episodic*unknown)
}

